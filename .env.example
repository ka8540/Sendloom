# Sendloom environment example.
# Copy to .env (or .env.local) and fill in. Never commit real secrets.

# --- Core ---
DATABASE_URL=postgresql://user:password@localhost:5432/sendloom
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/sendloom
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-min-12-chars
# Server-only HMAC key for signup/password verification codes. Use at least 32
# high-entropy characters. Never expose this as NEXT_PUBLIC_*.
AUTH_OTP_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Mail provider ---
MAIL_PROVIDER=gmail
# Authentication verification and legal account notices use Sendloom's Resend
# account independently of Gmail campaign sending.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=
# Account/service legal notices. Mass delivery is disabled unless this is true
# AND the runtime is a Vercel Production deployment. Keep false in local,
# Preview, Development, test, and CI environments.
LEGAL_NOTICE_PROCESSING_ENABLED=false
LEGAL_NOTICE_BATCH_SIZE=25
LEGAL_NOTICE_MAX_PER_RUN=50
# Admin-authored operational account notices. Real delivery also requires both
# NODE_ENV=production and VERCEL_ENV=production. Keep disabled until rollout.
SYSTEM_NOTICE_PROCESSING_ENABLED=false
SYSTEM_NOTICE_BATCH_SIZE=25
SYSTEM_NOTICE_MAX_PER_RUN=50
# Admin-authored Product Update feature announcements. Keep disabled for the
# initial deployment; enable only in Vercel Production after the migration,
# exact preview, admin workflow, and external five-minute cron are verified.
PRODUCT_UPDATE_PROCESSING_ENABLED=false
PRODUCT_UPDATE_BATCH_SIZE=25
PRODUCT_UPDATE_MAX_PER_RUN=50
GMAIL_USER=
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail bounce monitoring (mailbox watch + Cloud Pub/Sub push) ---
# Topic the Gmail watch publishes to, e.g. projects/<project-id>/topics/gmail-bounces.
GMAIL_PUBSUB_TOPIC=
# Shared secret appended to the push endpoint URL (?token=...). Either this or
# the OIDC audience below must be configured or the webhook rejects everything.
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Expected audience of the Pub/Sub OIDC push token (usually the webhook URL).
GMAIL_PUBSUB_AUDIENCE=
# Optional: the Pub/Sub push service account email the OIDC token must carry.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# --- Admin bootstrap ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- OpenAI (shared by template AI + prospect graph) ---
OPENAI_API_KEY=

# --- Incident reporting (server-only; required in production) ---
# Keys the anonymous reporter pseudonym (HMAC) and encrypts the reversible
# internal reporter reference (AES-256-GCM) for incident reports. Server-only —
# never prefix with NEXT_PUBLIC_. Use long random values (a 32-byte key for the
# encryption secret). In development both fall back to SESSION_SECRET.
REPORT_PSEUDONYM_SECRET=
REPORT_IDENTITY_ENCRYPTION_KEY=

# =============================================================================
# Prospect graph backend (local-first prototype — disabled by default)
# =============================================================================
# Apify
APIFY_API_TOKEN=
# Actor that performs the LinkedIn profile search. Default is the harvestapi
# actor; the numeric actor id M2FMdjRVeF1HPGFcc resolves to the same actor.
APIFY_PROSPECT_ACTOR_ID=harvestapi/linkedin-profile-search

# Legacy/secondary public web search for prospect email-format evidence.
# Supported values: none, serper, brave, you. The primary path is now AI web search
# (see PROSPECT_EMAIL_DISCOVERY_PROVIDER below); leave this as none unless you
# specifically want the deterministic scraper as a fallback. Direct source URL
# refresh works without this. `you` uses the official You.com Platform Web
# Search API (YDC_API_KEY, server-only) and is also the preferred provider for
# public people discovery (see DISCOVER_PEOPLE_PROVIDER below).
WEB_SEARCH_PROVIDER=none
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
YDC_API_KEY=

# Feature flags. Keep BOTH false in production. For local development set both
# to true to expose the GraphQL endpoint and the GraphiQL playground.
PROSPECT_GRAPH_ENABLED=false
# Additive pgvector role intelligence. Keep false until the vector migration is
# deployed; failures still fall back to the current database-first behavior.
DISCOVER_ROLE_VECTOR_ENABLED=false
DISCOVER_ROLE_EMBEDDING_MODEL=text-embedding-3-small
DISCOVER_ROLE_EMBEDDING_DIMENSIONS=1536
DISCOVER_ROLE_SEMANTIC_VERSION=v1
DISCOVER_ROLE_MAX_APIFY_TITLES=5
DISCOVER_ROLE_MAX_APIFY_TITLES_TOTAL=8
GRAPHQL_GRAPHIQL_ENABLED=false

# Hard local ceiling on results per search until the pipeline is stable.
LOCAL_PROSPECT_MAX_RESULTS=25

# AI controls
PROSPECT_AI_ENABLED=true
# Model for prospect AI tasks. Company resolution / role classification default
# to gpt-5; AI email-format web-search discovery defaults to gpt-5.5. Setting a
# value here overrides BOTH (e.g. PROSPECT_AI_MODEL=gpt-5.5). Leave blank to use
# the per-task defaults.
PROSPECT_AI_MODEL=
# Supported values: none, low, medium, high, xhigh. Legacy "minimal" is
# coerced to low because GPT-5.5 rejects it.
PROSPECT_AI_REASONING_EFFORT=low
# Per-search AI call ceilings. Normal usage is ~3 calls per company search:
# 1 company resolution + 1 batched title classification + 1 email inference.
PROSPECT_AI_MAX_COMPANY_CALLS_PER_SEARCH=2
PROSPECT_AI_MAX_ROLE_CALLS_PER_SEARCH=1
PROSPECT_AI_MAX_PATTERN_CALLS_PER_SEARCH=1
PROSPECT_AI_MAX_UNIQUE_TITLES=100
# Ambiguous-person name resolution. Only a person whose provider name is too
# incomplete to build an address from ("Jared C.") is ever sent to the model — a
# clean name is resolved deterministically and costs nothing. A surname is
# adopted only on HIGH-confidence public professional evidence; otherwise the
# person keeps no inferred email. Set the cap to 0, or the flag to false, to
# disable the fallback entirely.
PROSPECT_IDENTITY_RESOLUTION_ENABLED=true
PROSPECT_AI_MAX_IDENTITY_CALLS_PER_SEARCH=5

# When the inferred company email domain/pattern is LOW confidence, candidate
# emails are left null unless this is explicitly enabled for local testing.
PROSPECT_ALLOW_LOW_CONFIDENCE_EMAILS=false

# --- AI web-search email-format discovery (primary path) ---
# Find a company's public WORK email format with GPT-5.5 via the OpenAI Responses
# API built-in web_search tool. The AI returns structured public evidence only;
# the backend validates it, selects the email domain + pattern, and generates
# inferred emails deterministically. Requires OPENAI_API_KEY above.
#   - Supported provider values: none, openai_web_search.
# Without OPENAI_API_KEY (or with this set to none) "Find with AI" returns a
# clear NOT_CONFIGURED error in-app; "Use source URL" and manual override still
# work and never depend on AI. A failed/empty discovery never persists a format.
PROSPECT_EMAIL_DISCOVERY_PROVIDER=openai_web_search
# Master switch. When false, web search never runs (manual override + source URL
# still work).
PROSPECT_EMAIL_FORMAT_WEB_SEARCH_ENABLED=true
# How many public results the model is asked to weigh per company.
PROSPECT_EMAIL_FORMAT_MAX_WEB_RESULTS=5
# Per-user cost controls for the AI web-search discovery.
PROSPECT_EMAIL_FORMAT_AI_HOURLY_LIMIT=5
PROSPECT_EMAIL_FORMAT_AI_DAILY_LIMIT=20

# --- Discover daily usage limits ---
# Ordinary users get a fixed 10 people per processed Discover search and 4
# processed searches per daily (UTC) window (a max of 40 requested people/day).
# Drafts are free; the quota is consumed atomically when a draft is processed,
# and retrying the same search never consumes another slot. These default to the
# product values and rarely need changing.
DISCOVER_RESULTS_PER_SEARCH=10
DISCOVER_DAILY_SEARCH_LIMIT=4
# Server-only allowlist (comma-separated, case-insensitive) of accounts exempt
# from the DAILY Discover quota only — they still use the fixed per-search count
# and remain subject to auth, ownership, CSRF, and normal rate limits. The email
# is resolved from the authenticated session, never from a request body. Do NOT
# prefix with NEXT_PUBLIC_ and never expose this list to the client.
DISCOVER_QUOTA_EXEMPT_EMAILS=

# --- Shared Discover result cache ---
# Internal, cross-user cache of normalized Discover provider results. Identical
# canonical searches (same resolved company + role set + location set + fixed
# 10-result limit + cache version) reuse the cached people for this many days
# instead of calling Apify again; stale entries are refreshed on the next
# search. Absent/blank/invalid falls back to 30. Cached searches still consume
# the requesting user's daily quota; the cache never exposes another user's
# search history (it stores no requester identity).
DISCOVER_SHARED_CACHE_TTL_DAYS=30
# Cache schema version — part of the fingerprint. Bump to invalidate every
# existing entry (e.g. after changing what is stored). Defaults to v1.
DISCOVER_SHARED_CACHE_VERSION=v1

# --- Discover "Add 10 more" expansion ---
# "Add 10 more" extends an existing READY search with up to this many NEW unique
# people per request. Each request still uses one daily Discover slot. The
# enforced product value is 10; this override exists for operations only.
DISCOVER_EXPANSION_BATCH_SIZE=10
# Safety cap on provider continuation pages fetched in a single expansion, so a
# sparse query can never trigger an unbounded/expensive provider loop. Cached
# unused people are always used before any provider call, and continuation
# resumes after previously fetched pages (it never restarts at page 1).
DISCOVER_EXPANSION_MAX_PROVIDER_PAGES=5

# People discovery: default/rollback is apify. Server-only; never NEXT_PUBLIC_.
DISCOVER_PEOPLE_PROVIDER=apify
# public_search/hybrid prefer WEB_SEARCH_PROVIDER=you with YDC_API_KEY (official
# You.com Platform Web Search API, 25-result windows, LinkedIn domain filter).
# WEB_SEARCH_PROVIDER=serper with SERPER_API_KEY or WEB_SEARCH_PROVIDER=brave
# with BRAVE_SEARCH_API_KEY remain supported for compatibility.
# Limits: 6 queries, 3 windows/query (You.com 25 results/window; serper/brave
# 10 results/page), early stop as soon as enough valid unique people accept.
