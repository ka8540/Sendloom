generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ImportStatus {
  UPLOADING
  PROCESSED
  FAILED
}

enum CampaignStatus {
  DRAFT
  VALIDATED
  SCHEDULED
  WAITING_FOR_SLOT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum RunStatus {
  QUEUED
  WAITING_FOR_SLOT
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum RecipientJobStatus {
  PENDING
  SENT
  FAILED
  RETRYING
  SUPPRESSED
  INVALID
  CLICKED
  OPENED
  BOUNCED
  COMPLAINED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  INVALID_EMAIL
  MANUAL_BLOCK
}

enum ProviderEventType {
  ACCEPTED
  DELIVERED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  passwordHash             String?
  isAdmin                  Boolean              @default(false)
  hunterApiKeyEncrypted    String?
  hunterApiKeyLast4        String?
  hunterApiKeyUpdatedAt    DateTime?
  apiAccessDisabled        Boolean              @default(false)
  importsWriteDisabled     Boolean              @default(false)
  templatesWriteDisabled   Boolean              @default(false)
  launchesDisabled         Boolean              @default(false)
  aiEnhancementsDisabled   Boolean              @default(false)
  adultVerifiedAt          DateTime?
  termsAcceptedAt          DateTime?
  privacyAcceptedAt        DateTime?
  antiAbuseAcceptedAt      DateTime?
  policyVersion            String?
  ageGateVersion           String?
  eligibilityBlockedAt     DateTime?
  eligibilityBlockedReason String?
  restrictedAt             DateTime?
  restrictedReason         String?
  magicLinkToken           String?
  magicLinkExpiry          DateTime?
  lastLoginAt              DateTime?
  lastSeenAt               DateTime?
  sessionIssuedAt          DateTime?
  sessionExpiresAt         DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  senderProfiles           SenderProfile[]
  imports                  Import[]
  mappings                 Mapping[]
  templates                Template[]
  campaigns                Campaign[]
  suppressions             Suppression[]
  hunterDomainSearches     HunterDomainSearch[]
  prospectCompanies        ProspectCompany[]
  prospectPeople           ProspectPerson[]
  prospectSearches         ProspectSearch[]

  @@index([isAdmin])
  @@index([sessionExpiresAt])
}

model SenderProfile {
  id                        String         @id @default(cuid())
  userId                    String?
  name                      String
  fromEmail                 String         @unique
  provider                  String
  providerRef               String?
  oauthRefreshToken         String?
  oauthScope                String?
  lastReplySyncAt           DateTime?
  lastReplySyncError        String?
  // Gmail bounce monitoring (mailbox watch + delivery-status sync). The history
  // id is the last processed Gmail history position; status is a safe category
  // (ACTIVE / PERMISSION_REQUIRED / RECONNECT_REQUIRED / RENEWAL_FAILED /
  // UNAVAILABLE) — never a raw Google API error body.
  gmailWatchHistoryId       String?
  gmailWatchExpiresAt       DateTime?
  gmailWatchStatus          String?
  gmailWatchError           String?
  bounceLastSyncedAt        DateTime?
  bounceBackfillCompletedAt DateTime?
  metadata                  Json?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  user                      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaigns                 Campaign[]
  inboundReplies            InboundReply[]

  @@index([userId])
}

model Import {
  id           String         @id @default(cuid())
  userId       String?
  fileName     String
  fileType     String
  storagePath  String
  status       ImportStatus   @default(UPLOADING)
  rowCount     Int            @default(0)
  errorMessage String?
  sampleRows   Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  columns      ImportColumn[]
  rows         ImportRow[]
  mappings     Mapping[]
  campaigns    Campaign[]

  @@index([userId])
}

model ImportColumn {
  id          String   @id @default(cuid())
  importId    String
  sourceName  String
  normalized  String
  sampleType  String
  sampleValue String?
  createdAt   DateTime @default(now())
  import      Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
}

model ImportRow {
  id         String   @id @default(cuid())
  importId   String
  rowIndex   Int
  email      String?
  payload    Json
  normalized Json
  createdAt  DateTime @default(now())
  import     Import   @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowIndex])
  @@index([importId, email])
}

model Mapping {
  id               String     @id @default(cuid())
  userId           String?
  importId         String
  reservedFieldMap Json
  variableMap      Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  import           Import     @relation(fields: [importId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]

  @@index([userId])
}

model Template {
  id               String     @id @default(cuid())
  userId           String?
  name             String
  subject          String
  format           String     @default("HTML")
  htmlBody         String
  variableManifest Json
  previewPayload   Json?
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaigns        Campaign[]

  @@index([userId])
}

model Campaign {
  id                 String         @id @default(cuid())
  userId             String?
  name               String
  status             CampaignStatus @default(DRAFT)
  importId           String
  mappingId          String
  templateId         String
  senderProfileId    String
  scheduleType       String?
  scheduleConfig     Json?
  lastValidatedAt    DateTime?
  validationSnapshot Json?
  templateSnapshot   Json
  mappingSnapshot    Json
  senderSnapshot     Json
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  import             Import         @relation(fields: [importId], references: [id])
  mapping            Mapping        @relation(fields: [mappingId], references: [id])
  template           Template       @relation(fields: [templateId], references: [id])
  senderProfile      SenderProfile  @relation(fields: [senderProfileId], references: [id])
  runs               CampaignRun[]

  @@index([userId])
  @@index([userId, status])
}

model CampaignRun {
  id                     String         @id @default(cuid())
  campaignId             String
  status                 RunStatus      @default(QUEUED)
  launchType             String
  scheduledFor           DateTime?
  waitingForSlotAt       DateTime?
  executionSlotClaimedAt DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  progressSnapshot       Json?
  totalRecipients        Int            @default(0)
  sentCount              Int            @default(0)
  failedCount            Int            @default(0)
  suppressedCount        Int            @default(0)
  invalidCount           Int            @default(0)
  openedCount            Int            @default(0)
  clickedCount           Int            @default(0)
  repliedCount           Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  campaign               Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientJobs          RecipientJob[]

  @@index([campaignId, status])
  @@index([status, executionSlotClaimedAt])
  @@index([status, waitingForSlotAt, id])
}

model RecipientJob {
  id                String             @id @default(cuid())
  campaignRunId     String
  importRowId       String
  recipientEmail    String
  recipientName     String?
  subject           String
  htmlBody          String
  dedupeKey         String             @unique
  status            RecipientJobStatus @default(PENDING)
  retryCount        Int                @default(0)
  nextRetryAt       DateTime?
  providerMessageId String?
  repliedAt         DateTime?
  replyCount        Int                @default(0)
  lastError         String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaignRun       CampaignRun        @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)
  inboundReplies    InboundReply[]

  @@index([campaignRunId, status])
  @@index([recipientEmail])
}

model InboundReply {
  id              String        @id @default(cuid())
  senderProfileId String
  recipientJobId  String?
  gmailMessageId  String        @unique
  gmailThreadId   String?
  fromEmail       String?
  subject         String?
  snippet         String?
  receivedAt      DateTime
  payload         Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  senderProfile   SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Cascade)
  recipientJob    RecipientJob? @relation(fields: [recipientJobId], references: [id], onDelete: SetNull)

  @@index([senderProfileId, receivedAt])
  @@index([recipientJobId, receivedAt])
}

model ProviderEvent {
  id                String            @id @default(cuid())
  provider          String
  providerMessageId String
  eventType         ProviderEventType
  payload           Json
  createdAt         DateTime          @default(now())

  @@unique([provider, providerMessageId, eventType])
}

model Suppression {
  id                   String            @id @default(cuid())
  userId               String?
  email                String
  reason               SuppressionReason
  source               String
  notes                String?
  // Delivery-failure detail (set only for confirmed bounce suppressions).
  // enhancedStatusCode is the SMTP enhanced code (e.g. "5.1.1"), failureCategory
  // a safe classifier category — never a raw DSN body or provider payload.
  enhancedStatusCode   String?
  failureCategory      String?
  firstFailedAt        DateTime?
  lastFailedAt         DateTime?
  failureCount         Int               @default(0)
  sourceGmailMessageId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@index([userId])
}

model RateLimitWindow {
  id          String   @id @default(cuid())
  windowKey   String   @unique
  sentCount   Int      @default(0)
  windowStart DateTime
  windowEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SendLedger {
  id              String   @id @default(cuid())
  userId          String?
  senderProfileId String?
  campaignId      String?
  campaignRunId   String?
  recipientJobId  String?
  kind            String   @default("INITIAL")
  provider        String   @default("GMAIL")
  messageId       String?
  threadId        String?
  sentAt          DateTime
  createdAt       DateTime @default(now())

  @@index([senderProfileId, sentAt])
  @@index([userId, sentAt])
  @@index([recipientJobId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String
  actorName   String?
  action      String
  category    String   @default("SYSTEM")
  severity    String   @default("INFO")
  entityType  String?
  entityId    String?
  targetName  String?
  message     String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
}

// --- Error recovery & incident reporting ------------------------------------
// A sanitized technical record of an eligible operational failure, captured once
// when it happens. It holds ONLY allow-listed, non-identifying diagnostics (no
// name/email/user id/tokens/IP/contacts/message content). Status / severity /
// category are stored as validated strings (mirroring the AuditLog convention),
// not DB enums. The reversible reporter reference lives on IncidentReport, never
// here.
model AppErrorEvent {
  id                     String   @id @default(cuid())
  // Non-sequential public id (EVT-XXXXXX) so volume is never inferable.
  publicEventId          String   @unique
  category               String
  feature                String
  operation              String
  internalCode           String?
  httpStatus             Int?
  correlationId          String?
  // Pathname only — query string + values are stripped before persistence.
  route                  String?
  requestMethod          String?
  appVersion             String?
  browserFamily          String?
  platform               String?
  onlineStatus           Boolean?
  retryable              Boolean  @default(false)
  // Allow-list built diagnostic object (never an arbitrary scraped payload).
  sanitizedContext       Json?
  diagnosticFingerprint  String?
  serverStackFingerprint String?
  occurredAt             DateTime
  createdAt              DateTime @default(now())

  reports IncidentReport[]

  @@index([category, createdAt])
  @@index([diagnosticFingerprint])
}

// A user-submitted incident report. The affected account is represented only by
// a stable HMAC pseudonym (reporterPseudonym, e.g. U-7F2A-91C4). A reversible
// reference is stored AES-256-GCM encrypted (encryptedReporter*) for internal
// follow-up only and is NEVER returned to any client (admin or reporter). Status
// / severity are validated strings; severity is derived server-side.
model IncidentReport {
  id                    String   @id @default(cuid())
  // Non-sequential public id (INC-XXXXXX), safe to show the reporter + admin.
  publicReportId        String   @unique
  errorEventId          String?
  reporterPseudonym     String
  // Authenticated-encryption ciphertext + IV + tag. Admin-facing DTOs OMIT these.
  encryptedReporterRef  String?
  encryptedReporterIv   String?
  encryptedReporterTag  String?
  // Optional free-text note, redacted (emails/phones/tokens) + length-capped.
  userNote              String?
  // NEW | INVESTIGATING | RESOLVED | IGNORED (validated at the API boundary).
  status                String   @default("NEW")
  // CRITICAL | HIGH | MEDIUM | LOW — derived server-side, never client supplied.
  severity              String
  occurrenceCount       Int      @default(1)
  diagnosticFingerprint String?
  firstSeenAt           DateTime
  lastSeenAt            DateTime
  // Internal triage notes — never returned to the reporting user.
  adminNotes            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  errorEvent AppErrorEvent? @relation(fields: [errorEventId], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([severity, lastSeenAt])
  @@index([reporterPseudonym, diagnosticFingerprint])
  @@index([reporterPseudonym, lastSeenAt])
}

model HunterDomainSearch {
  id          String   @id @default(cuid())
  userId      String
  domain      String
  resultCount Int      @default(0)
  results     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId, updatedAt])
}

// --- Prospect graph (backend-only prototype) ---------------------------------
// A relational graph exposed through GraphQL as Company -> Position -> People.
// Category / status / confidence values are stored as strings (mirroring the
// AuditLog pattern of string consts) and validated against GraphQL enums at the
// API boundary, never trusted directly from AI output.

model ProspectCompany {
  id                      String    @id @default(cuid())
  userId                  String
  // Tenant-local canonical identity. Resolved domains are authoritative;
  // normalized company names are only a fallback while a domain is unknown.
  canonicalKey            String
  name                    String
  normalizedName          String
  officialName            String?
  officialDomain          String?
  officialWebsiteDomain   String?
  officialWebsite         String?
  linkedinUrl             String?
  domainConfidence        String    @default("UNAVAILABLE")
  emailDomain             String?
  emailDomainConfidence   String    @default("UNAVAILABLE")
  emailDomainEvidence     Json?
  emailPattern            String?
  patternConfidence       String    @default("UNAVAILABLE")
  patternEvidence         Json?
  // MANUAL | SOURCE | AI | SHARED_CACHE | UNRESOLVED. The canonical merge
  // policy uses this to prevent lower-authority updates from erasing evidence.
  emailFormatAuthority    String    @default("UNRESOLVED")
  // Short, human-readable summary of why this format was selected (from the AI
  // web-search discovery). Reset on every inference.
  emailFormatReason       String?
  // When the email format was last discovered/inferred. Drives the cache that
  // avoids paying for AI web search again within the freshness window.
  emailFormatDiscoveredAt DateTime?
  // Typed outcome of the most recent automatic/source/manual discovery. This
  // keeps provider/config/parser failures distinct from genuine no-evidence.
  emailFormatDiscoveryStatus String   @default("NOT_ATTEMPTED")
  emailFormatDiscoveryReason String?
  emailFormatDiscoveryAt     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions ProspectCompanyPosition[]
  people    ProspectPerson[]
  searches  ProspectSearch[]

  @@unique([userId, canonicalKey])
  @@index([userId, normalizedName])
  @@index([userId, officialDomain])
  @@index([userId, emailDomain])
}

model ProspectCompanyPosition {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  displayName String
  rawTitles   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company ProspectCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people  ProspectPerson[]

  @@unique([companyId, category])
  @@index([companyId])
}

model ProspectPerson {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  positionId      String
  sourceProfileId String
  firstName       String
  lastName        String
  fullName        String
  currentTitle    String?
  normalizedTitle String?
  location        String?
  country         String?
  state           String?
  city            String?
  linkedinUrl     String
  inferredEmail   String?
  emailStatus     String   @default("UNAVAILABLE")
  emailConfidence String   @default("UNAVAILABLE")
  emailPattern    String?
  emailSource     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     ProspectCompany         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position    ProspectCompanyPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  allocations ProspectSearchPerson[]

  @@unique([userId, sourceProfileId])
  @@index([companyId, positionId])
  @@index([userId, emailStatus])
}

// One person GRANTED to one user-owned search action. This is the ownership
// boundary between the shared cross-user Discover cache (which may hold far more
// candidates than any one user is entitled to) and what a user actually
// receives: an initial search allocates at most `maxResults` people, and each
// "Add 10 more" expansion allocates at most one more batch. Every user-facing
// count (grouped dashboard people, role tabs, exports) derives from these rows —
// never from the shared cache pool size. allocationSource records how the grant
// happened (CACHE | PROVIDER | ADD_MORE_CACHE | ADD_MORE_PROVIDER | BACKFILL)
// and allocationOrder preserves the deterministic batch order for repair.
model ProspectSearchPerson {
  id               String   @id @default(cuid())
  searchId         String
  personId         String
  userId           String
  allocationOrder  Int      @default(0)
  allocationSource String   @default("CACHE")
  allocatedAt      DateTime @default(now())

  search ProspectSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  person ProspectPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([searchId, personId])
  @@index([personId])
  @@index([searchId, allocationOrder])
  @@index([userId, searchId])
}

model ProspectSearch {
  id                     String    @id @default(cuid())
  userId                 String
  companyId              String?
  requestedCompany       String
  requestedDomain        String?
  requestedLinkedin      String?
  requestedTitles        Json
  requestedLocations     Json?
  maxResults             Int
  status                 String    @default("DRAFT")
  apifyRunId             String?
  apifyDatasetId         String?
  errorCode              String?
  errorMessage           String?
  totalFound             Int       @default(0)
  totalProcessed         Int       @default(0)
  // Internal result provenance for the shared Discover cache. Never exposed via
  // GraphQL. resultSource is CACHE (reused a shared dataset) or PROVIDER (called
  // Apify); the remaining fields record which shared cache entry was used.
  resultSource           String?
  sharedCacheId          String?
  cacheFingerprint       String?
  cacheFetchedAt         DateTime?
  // Processing-attempt instrumentation. A user-triggered retry starts a NEW
  // attempt (attemptCount increments, lastAttemptId rotates); a network replay of
  // the same client idempotency key reuses the current attempt so it is never
  // double-counted. Internal diagnostics only — never exposed via GraphQL.
  attemptCount           Int       @default(0)
  lastAttemptId          String?
  lastAttemptStartedAt   DateTime?
  lastAttemptCompletedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     ProspectCompany?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  expansions  DiscoverSearchExpansion[]
  allocations ProspectSearchPerson[]

  @@index([userId, createdAt])
  @@index([status])
}

// One "Add 10 more" request against a READY ProspectSearch. This is the durable
// idempotency + audit record for an expansion: a generated idempotencyKey makes
// double clicks / network retries reuse the same row (so they never consume a
// second daily quota slot, launch a second provider run, or add a second batch),
// and the stored counts let a retry of a completed/failed expansion return the
// same result without redoing any paid work. One active (PENDING/PROCESSING)
// expansion may exist per search at a time. Holds only safe counters — never
// people lists, emails, or raw provider payloads.
model DiscoverSearchExpansion {
  id               String    @id @default(cuid())
  searchId         String
  userId           String
  idempotencyKey   String
  requestedCount   Int       @default(10)
  addedCount       Int       @default(0)
  cacheCount       Int       @default(0)
  providerCount    Int       @default(0)
  totalPeopleCount Int       @default(0)
  // PENDING | PROCESSING | READY | FAILED (validated against the GraphQL enum).
  status           String    @default("PENDING")
  quotaReserved    Boolean   @default(false)
  exhausted        Boolean   @default(false)
  errorCode        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  search ProspectSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@unique([searchId, idempotencyKey])
  @@index([searchId, status])
  @@index([searchId, createdAt])
}

// Shared, cross-user 30-day cache of normalized Discover provider results. This
// is an INTERNAL provider-result cache — never a public search-history surface.
// It stores only the normalized public professional dataset and evidence-backed
// company email-format metadata required to reuse a search without calling Apify
// again. It deliberately holds NO requester identity (no userId), no user
// selections/exports/imports, and no raw provider payloads. Each requesting user
// still gets their own user-owned ProspectCompany/Person/Search materialized
// from this data. Match is by an exact canonical fingerprint (see
// discover-cache-fingerprint).
model DiscoverSearchCache {
  id                    String    @id @default(cuid())
  fingerprint           String    @unique
  cacheVersion          String
  companyKey            String
  companyName           String
  companyDomain         String?
  companyLinkedinUrl    String?
  normalizedRoles       Json
  normalizedLocations   Json
  resultLimit           Int
  // READY (fresh/usable) | REFRESHING (a holder is repopulating) | FAILED.
  status                String    @default("REFRESHING")
  fetchedAt             DateTime?
  expiresAt             DateTime?
  refreshStartedAt      DateTime?
  lastErrorCode         String?
  resultCount           Int       @default(0)
  // Provider continuation state for "Add 10 more". An expansion never restarts
  // the provider at page 1: providerNextPage is the next page to fetch,
  // providerPagesFetched counts pages already pulled into this entry, and
  // providerExhausted is set once the provider confirms there are no further
  // pages / no new unique people. lastProviderFetchAt records the last fetch.
  providerNextPage      Int       @default(1)
  providerPagesFetched  Int       @default(0)
  providerExhausted     Boolean   @default(false)
  lastProviderFetchAt   DateTime?
  // Evidence-backed company email-format metadata (safe to share). A manual
  // per-user override is never written here.
  emailDomain           String?
  emailDomainConfidence String    @default("UNAVAILABLE")
  emailDomainEvidence   Json?
  emailPattern          String?
  patternConfidence     String    @default("UNAVAILABLE")
  patternEvidence       Json?
  emailFormatReason     String?
  // Email-format discovery has its own state/TTL; people-cache freshness must
  // never suppress a missing/stale/transiently-failed format retry.
  emailFormatDiscoveryStatus    String   @default("NOT_ATTEMPTED")
  emailFormatDiscoveryReason    String?
  emailFormatDiscoveryAt        DateTime?
  emailFormatDiscoveryExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  people DiscoverSearchCachePerson[]

  @@index([companyKey])
  @@index([expiresAt])
  @@index([status])
  @@index([emailFormatDiscoveryStatus])
}

// One normalized, public professional record inside a shared cache entry. No
// userId, no requester identity, no raw biography/photo/phone/personal email.
model DiscoverSearchCachePerson {
  id               String   @id @default(cuid())
  cacheId          String
  // Deterministic provider order within the entry (page 1 first, then each
  // appended continuation page). Drives stable "first 10 / next 10" batching.
  sortIndex        Int      @default(0)
  sourceProfileId  String
  firstName        String
  lastName         String
  fullName         String
  currentTitle     String?
  normalizedTitle  String?
  positionCategory String?
  location         String?
  country          String?
  state            String?
  city             String?
  linkedinUrl      String
  inferredEmail    String?
  emailStatus      String   @default("UNAVAILABLE")
  emailConfidence  String   @default("UNAVAILABLE")
  emailPattern     String?
  emailSource      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cache DiscoverSearchCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)

  @@unique([cacheId, sourceProfileId])
  @@index([cacheId, positionCategory])
  @@index([cacheId, sortIndex])
}

// Global, AI-result cache so the same normalized title is never re-classified by
// the model across searches or companies (see role-classification-service).
model ProspectTitleClassification {
  id              String   @id @default(cuid())
  normalizedTitle String   @unique
  category        String
  displayName     String
  confidence      String   @default("MEDIUM")
  source          String   @default("AI") // DETERMINISTIC | AI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
